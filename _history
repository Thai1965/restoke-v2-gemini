l) {\n                currentX += WIDTH + SPACING;\n                continue;\n            }\n\n            for (let row = 0; row < HEIGHT; row++) {\n                let rowData = glyph[row];\n                for (let col = 0; col < WIDTH; col++) {\n                    // ตรวจสอบบิตแนวนอนจากซ้ายสุด (0x80)\n                    if ((rowData & (0x80 >> col)) != 0) {\n                        // ส่งไปสลับบิตสีผ่าน DisplayUtils ป้องกันสีน้ำเงินเพี้ยน\n                        let correctColor = DisplayUtils.swapRGB(color);\n                        RBTFT18.drawPixel(currentX + col, y + row, correctColor);\n                    }\n                }\n            }\n            currentX += WIDTH + SPACING;\n            if (currentX >= 128) break;\n        }\n    }\n}\n"}]},{"timestamp":1786001583946,"editorVersion":"9.0.8","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":415,"length1":0,"diffs":[[1,"Font6x8.drawText6x8(\"Meya\", 1, 60, Color.Green);\nFont6x8.drawText6x8(\"NoNoNo\", 1, 80, Color.Blue);\nFont6x8.drawText6x8(\"1111111\", 1, 100, Color.Orange);\nFont6x8.drawText6x8(\"IIIIIII\", 1, 120, Color.Cyan);\n"]]},{"start1":621,"length1":1,"diffs":[[1,""]]}]},{"type":"edited","filename":"font6x8.ts","patch":[{"start1":4367,"length1":253,"diffs":[[1,""]]},{"start1":4484,"length1":133,"diffs":[[1,""]]},{"start1":4641,"length1":85,"diffs":[[1,""]]},{"start1":4727,"length1":346,"diffs":[[1,""]]},{"start1":4822,"length1":170,"diffs":[[1,""]]},{"start1":4878,"length1":0,"diffs":[[1,"                    // ตรวจสอบบิตแนวนอนจากซ้ายสุด (0x80)\n"]]},{"start1":4993,"length1":0,"diffs":[[1,"                        // ส่งไปสลับบิตสีผ่าน DisplayUtils ป้องกันสีน้ำเงินเพี้ยน\n"]]},{"start1":5147,"length1":89,"diffs":[[1,"                        RBTFT18.drawPixel(currentX + col, y + row, correctColor);\n"]]},{"start1":5283,"length1":102,"diffs":[[1,""]]},{"start1":5324,"length1":0,"diffs":[[1,"            if (currentX >= 128) break;\n"]]},{"start1":5380,"length1":2,"diffs":