โก้ดส่วนอื่นๆ ของ Font8x16 ...\n\n    export function drawText8x16(text: string, x: number, y: number, color: number): void {\n        let currentX = x;\n        for (let i = 0; i < text.length; i++) {\n            let ch = text.charAt(i);\n            let glyph = getGlyph(ch);\n\n            if (glyph == null) { currentX += WIDTH + SPACING; continue; }\n\n            for (let row = 0; row < HEIGHT; row++) {\n                let rowData = glyph[row];\n                for (let col = 0; col < WIDTH; col++) {\n                    if ((rowData & (0x80 >> col)) != 0) {\n\n                        // ปรับตรงนี้: ส่งค่าสีไปแปลงผ่านฟังก์ชันส่วนกลางก่อนส่งให้จอวาด\n                        let correctColor = DisplayUtils.swapRGB(color);\n                        RBTFT18.drawPixel(currentX + col, y + row, correctColor);\n\n                    }\n                }\n            }\n            currentX += WIDTH + SPACING;\n            if (currentX >= 128) break;\n        }\n    }\n}\n\n","display_utils.ts":"// Add your code here\nnamespace DisplayUtils {\n    /**\n     * ฟังก์ชันส่วนกลางสำหรับสลับสีฮาร์ดแวร์จอ RGB -> BGR\n     * สามารถเรียกใช้ร่วมกันได้จากฟอนต์ทุกขนาด\n     */\n    export function swapRGB(color: number): number {\n        let r = (color >> 11) & 0x1F;\n        let g = (color >> 5) & 0x3F;\n        let b = color & 0x1F;\n        return (b << 11) | (g << 5) | r;\n    }\n}\n","font6x8.ts":"// Add your code here\nnamespace Font6x8 {\n    export const WIDTH = 6\n    export const HEIGHT = 8\n    export const SPACING = 1\n\n    // ==================================================\n    // ข้อมูลฟอนต์มาตรฐาน 6x8 แบบแนวนอน (Horizontal) 8 แถว แถวละ 1 Byte\n    // ==================================================\n    export const A = [0x18, 0x24, 0x42, 0x42, 0x7E, 0x42, 0x42, 0x00]\n    export const B = [0x7C, 0x42, 0x42, 0x7C, 0x42, 0x42, 0x7C, 0x00]\n    export const C = [0x3C, 0x42, 0x40, 0x40, 0x40, 0x42, 0x3C, 0x00]\n    export const D = [0x78, 0x44, 0x42, 0x42, 0x42, 