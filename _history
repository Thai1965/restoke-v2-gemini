olor.Black)[cite: 1]\n"]]},{"start1":6975,"length1":57,"diffs":[[1,"            valueStr = \"Value: \" + configRep + \" (0-20)\"[cite: 3]\n"]]},{"start1":7094,"length1":60,"diffs":[[1,"            valueStr = \"Value: +/-\" + configAcc + \" (0-10)\"[cite: 3]\n"]]},{"start1":7221,"length1":175,"diffs":[[1,"            drawString6x8(\"DD/MM/YY: 07/08/26\", 2, startY, Color.White, Color.Black)[cite: 1, 3]\n            drawString6x8(\"HH:MM:SS: 14:30:00\", 2, startY + 14, Color.White, Color.Black)[cite: 1, 3]\n"]]},{"start1":7474,"length1":63,"diffs":[[1,"            valueStr = \"Status: \" + (configBle ? \"ON\" : \"OFF\")[cite: 3]\n"]]},{"start1":7601,"length1":73,"diffs":[[1,"            valueStr = \"Confirm: \" + (configClearConfirm ? \"YES\" : \"NO\")[cite: 3]\n"]]},{"start1":7708,"length1":134,"diffs":[[1,"    RBTFT18.drawRectangle(0, startY + 10, 128, 16, Color.White)[cite: 1]\n    drawString6x8(valueStr, 2, startY + 14, Color.Black, Color.White)[cite: 1]\n"]]},{"start1":10754,"length1":15,"diffs":[[1,"RBTFT18.init()[cite: 1]\n"]]}]}]},{"timestamp":1786089883175,"editorVersion":"9.0.8","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":133,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"><statement name=\"HANDLER\"><block type=\"RBTFT18_init\"><comment pinned=\"false\" h=\"80\" w=\"160\">ตัวอย่างโค้ดในไฟล์หลัก main.ts\n1. เคลียร์เปิดการทำงานหน้าจอ</comment><next><block type=\"RBTFT18_clearScreen\"><comment pinned=\"false\" h=\"80\" w=\"160\">2. ล้างหน้าจอเป็นสีดำ</comment><next><block type=\"typescript_statement\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" line0=\"Font8x16.drawText8x16(&quot;STATUS&quot;, 1, 20, Color.White);\" numlines=\"1\"></mutation><next><block type=\"typescript_statement\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" line0=\"Font6x8.drawText6x8(&quot;ABCDEFGHIJKLMNOPQRSTUVWXYZ&quot;, 1, 40, Color.Red);\" numlines=\"1\"></mutation><next><block type=\"bluetooth_start_led_service\"><next><block type=\"bluetooth_start_button_service\"><next><block type=\"bluetooth_start_accelerometer_service\"><next><block type=\"bluetooth_start_uart_service\"><next><block type=\"bluetooth_uart_write\"><value name=\"data\"><shadow type=\"text\"><field name=\"TEXT\">M</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type=\"bluetooth_on_connected\" x=\"675\" y=\"0\"><statement name=\"HANDLER\"><block type=\"basic_show_icon\"><field name=\"i\">IconNames.Yes</field></block></statement></block><block type=\"bluetooth_on_disconnected\" x=\"505\" y=\"331\"><statement name=\"HANDLER\"><block type=\"basic_show_icon\"><field name=\"i\">IconNames.No</field></block></statement></block><block type=\"device_forever\" x=\"346\" y=\"519\"></block></xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":0,"diffs":[[1,"// ==========================================\n// 1. FONT BINDING & HELPER\n// ==========================================\n"]]},{"start1":121,"length1":0,"diffs":[[1,"/**\n * ดึงข้อมูล Bitmap 1 ตัวอักษร\n */\nfunction getFontData(fontObj: any, code: number): number[] {\n    if (!fontObj) return null\n    if (typeof fontObj.getCharBytes === \"function\") {\n        return fontObj.getCharBytes(code)\n    }\n    if (Array.isArray(fontObj)) {\n        return fontObj[code] || fontObj[code - 32]\n    }\n    if (fontObj[code]) return fontObj[code]\n    if (fontObj[code - 32]) return fontObj[code - 32]\n    return null\n}\n\n/**\n * วาดตัวอักษร Font 6x8 พิกเซลลงจอโดยตรง\n */\nfunction drawChar6x8(char: string, x: number, y: number, color: Color, bgColor: Color) {\n    let code = char.charCodeAt(0)\n    let charBytes = getFontData((font6x8 as any), code)\n\n    if (!charBytes) {\n        RBTFT18.showString(char, x, y, 1, color, bgColor)\n        return\n    }\n\n    for (let col = 0; col < 6; col++) {\n        let byte = charBytes[col]\n        for (let row = 0; row < 8; row++) {\n            if ((byte & (1 << row)) != 0) {\n                RBTFT18.drawPixel(x + col, y + row, color)\n            } else {\n                RBTFT18.drawPixel(x + col, y + row, bgColor)\n            }\n        }\n    }\n}\n\nfunction drawString6x8(str: string, x: number, y: number, color: Color, bgColor: Color) {\n    for (let i = 0; i < str.length; i++) {\n        drawChar6x8(str.charAt(i), x + (i * 6), y, color, bgColor)\n    }\n}\n\n/**\n * วาดตัวอักษร Font 8x16 พิกเซลลงจอโดยตรง\n */\nfunction drawChar8x16(char: string, x: number, y: number, color: Color, bgColor: Color) {\n    let code = char.charCodeAt(0)\n    let charBytes = getFontData(Font8x16, code)\n\n    if (!charBytes) {\n        RBTFT18.showString(char, x, y, 2, color, bgColor)\n        return\n    }\n\n    for (let row = 0; row < 16; row++) {\n        let byte = charBytes[row]\n        for (let col = 0; col < 8; col++) {\n            if ((byte & (0x80 >> col)) != 0) {\n                RBTFT18.drawPixel(x + col, y + row, color)\n            } else {\n                RBTFT18.drawPixel(x + col, y + row, bgColor)\n            }\n        }\n    }\n}\n\nfunction drawString8x16(str: string, x: number, y: number, color: Color, bgColor: Color) {\n    for (let i = 0; i < str.length; i++) {\n        drawChar8x16(str.charAt(i), x + (i * 8), y, color, bgColor)\n    }\n}\n\n// ==========================================\n// 2. STATE MACHINE & GLOBAL VARIABLES\n// ==========================================\nenum MenuState {\n    MAIN_MENU,\n    EXERCISE_MENU,\n    CONFIG_MENU,\n    CONFIG_REP,\n    CONFIG_ACC,\n    CONFIG_DATETIME,\n    CONFIG_BLE,\n    CONFIG_CLEAR,\n    POWER_OFF\n}\n\nlet currentState: MenuState = MenuState.MAIN_MENU\nlet lastState: MenuState = -1\nlet currentIndex: number = 0\nlet lastIndex: number = -1\n\n// ค่า Configuration\nlet configRep: number = 10         // 0 - 20\nlet configAcc: number = 5          // 0 - 10\nlet configBle: boolean = false     // true = On, false = Off\nlet configClearConfirm: boolean = false // false = N, true = Y\n\n// รายการเมนู[cite: 3]\nconst mainMenu = [\"1. Exercise\", \"2. Config\", \"3. Test\", \"4. Power off\"]\nconst exerciseMenu = [\"1. Up and Down\", \"2. Left and Right\", \"3. View Log\", \"4. Calibration\", \"5. Back\"]\nconst configMenu = [\"1. Repetition\", \"2. Accuracy\", \"3. Date/Time\", \"4. Bluetooth\", \"5. Clear Data\", \"6. Back\"]\n\n// ==========================================\n// 3. EFFICIENT UI RENDERER (Partial Redraw)\n// ==========================================\n\nfunction drawMenuItem(text: string, index: number, startY: number, itemHeight: number, isSelected: boolean) {\n    let y = startY + (index * itemHeight)\n    let bg = isSelected ? Color.White : Color.Black\n    let fg = isSelected ? Color.Black : Color.White\n\n    // วาดสี่เหลี่ยมไฮไลต์เฉพาะบรรทัด[cite: 3]\n    RBTFT18.drawRectangle(0, y, 128, itemHeight, bg)\n    // วาดข้อความทับด้วย Font 6x8 (เว้นขอบซ้าย 2 pixel)\n    drawString6x8(text, 2, y + 2, fg, bg)\n}\n\nfunction renderUI(fullRefresh: boolean = false) {\n    // 1. กรณี Power Off[cite: 3]\n    if (currentState == MenuState.POWER_OFF) {\n        RBTFT18.clearScreen()\n        RBTFT18.turnOff()\n        return\n    }\n\n    // 2. ถ้าเปลี่ยน State ให้เคลียร์จอและวาดโครงสร้างหลักใหม่เพียงครั้งเดียว\n    if (currentState != lastState || fullRefresh) {\n        RBTFT18.turnOn()\n        RBTFT18.clearScreen()\n\n        // วาดชื่อเมนู บรรทัดบนสุด ชิดซ้าย Font 8x16 สีเขียว[cite: 3]\n        let title = \"\"\n        switch (currentState) {\n            case MenuState.MAIN_MENU: title = \"Main Menu\"; break\n            case MenuState.EXERCISE_MENU: title = \"Exercise\"; break\n            case MenuState.CONFIG_MENU: title = \"Config\"; break\n            case MenuState.CONFIG_REP: title = \"Set Reps\"; break\n            case MenuState.CONFIG_ACC: title = \"Set Accuracy\"; break\n            case MenuState.CONFIG_DATETIME: title = \"Date/Time\"; break\n            case MenuState.CONFIG_BLE: title = \"Bluetooth\"; break\n            case MenuState.CONFIG_CLEAR: title = \"Clear Data\"; break\n        }\n        drawString8x16(title, 0, 0, Color.Green, Color.Black)\n\n        // เหนือ วัน/เวลา แสดงข้อความ A=Up, B=Down, C=Select Font 6x8 สีขาว\n        drawString6x8(\"A=Up, B=Down, C=Select\", 0, 136, Color.White, Color.Black)\n\n        // ด้านล่างจอภาพแสดง วันที่และเวลา ชิดซ้าย Font 6x8 สีฟ้า\n        drawString6x8(\"07/08/26 14:30:00\", 0, 148, Color.Cyan, Color.Black)\n\n        // วาดเมนูทั้งหมดของ State ใหม่\n        let startY = 24\n        let itemHeight = 12\n        let currentMenu = getActiveMenu()\n\n        if (currentMenu.length > 0) {\n            for (let i = 0; i < currentMenu.length; i++) {\n                drawMenuItem(currentMenu[i], i, startY, itemHeight, i == currentIndex)\n            }\n        } else {\n            drawConfigDetail(startY)\n        }\n\n        lastState = currentState\n        lastIndex = currentIndex\n        return\n    }\n\n    // 3. การทำ Partial Redraw เมื่อเลื่อนปุ่มกดบนเมนูเดียวกัน\n    if (currentIndex != lastIndex) {\n        let startY = 24\n        let itemHeight = 12\n        let currentMenu = getActiveMenu()\n\n        if (currentMenu.length > 0) {\n            if (lastIndex >= 0 && lastIndex < currentMenu.length) {\n                drawMenuItem(currentMenu[lastIndex], lastIndex, startY, itemHeight, false)\n            }\n            drawMenuItem(currentMenu[currentIndex], currentIndex, startY, itemHeight, true)\n        } else {\n            drawConfigDetail(startY)\n        }\n        lastIndex = currentIndex\n    }\n}\n\nfunction getActiveMenu(): string[] {\n    switch (currentState) {\n        case MenuState.MAIN_MENU: return mainMenu\n        case MenuState.EXERCISE_MENU: return exerciseMenu\n        case MenuState.CONFIG_MENU: return configMenu\n        default: return []\n    }\n}\n\nfunction drawConfigDetail(startY: number) {\n    let valueStr = \"\"\n    switch (currentState) {\n        case MenuState.CONFIG_REP:\n            valueStr = \"Value: \" + configRep + \" (0-20)\"\n            break\n        case MenuState.CONFIG_ACC:\n            valueStr = \"Value: +/-\" + configAcc + \" (0-10)\"\n            break\n        case MenuState.CONFIG_DATETIME:\n            drawString6x8(\"DD/MM/YY: 07/08/26\", 2, startY, Color.White, Color.Black)\n            drawString6x8(\"HH:MM:SS: 14:30:00\", 2, startY + 14, Color.White, Color.Black)\n            return\n        case MenuState.CONFIG_BLE:\n            valueStr = \"Status: \" + (configBle ? \"ON\" : \"OFF\")\n            break\n        case MenuState.CONFIG_CLEAR:\n            valueStr = \"Confirm: \" + (configClearConfirm ? \"YES\" : \"NO\")\n            break\n    }\n\n    RBTFT18.drawRectangle(0, startY + 10, 128, 16, Color.White)\n    drawString6x8(valueStr, 2, startY + 14, Color.Black, Color.White)\n}\n\n// ==========================================\n// 4. BUTTON CONTROLLERS\n// ==========================================\n\ninput.onButtonPressed(Button.A, function () { // ปุ่ม A = Up, Left[cite: 3]\n    if (currentState == MenuState.POWER_OFF) return\n\n    let menu = getActiveMenu()\n    if (menu.length > 0) {\n        currentIndex = (currentIndex - 1 + menu.length) % menu.length\n    } else {\n        if (currentState == MenuState.CONFIG_REP && configRep > 0) configRep--\n        else if (currentState == MenuState.CONFIG_ACC && configAcc > 0) configAcc--\n        else if (currentState == MenuState.CONFIG_BLE) configBle = !configBle\n        else if (currentState == MenuState.CONFIG_CLEAR) configClearConfirm = !configClearConfirm\n    }\n    renderUI()\n})\n\ninput.onButtonPressed(Button.B, function () { // ปุ่ม B = Down, Right[cite: 3]\n    if (currentState == MenuState.POWER_OFF) return\n\n    let menu = getActiveMenu()\n    if (menu.length > 0) {\n        currentIndex = (currentIndex + 1) % menu.length\n    } else {\n        if (currentState == MenuState.CONFIG_REP && configRep < 20) configRep++\n        else if (currentState == MenuState.CONFIG_ACC && configAcc < 10) configAcc++\n        else if (currentState == MenuState.CONFIG_BLE) configBle = !configBle\n        else if (currentState == MenuState.CONFIG_CLEAR) configClearConfirm = !configClearConfirm\n    }\n    renderUI()\n})\n\ninput.onButtonPressed(Button.AB, function () { // ปุ่ม C = Ok/Select[cite: 3]\n    if (currentState == MenuState.POWER_OFF) return\n\n    switch (currentState) {\n        case MenuState.MAIN_MENU:\n            if (currentIndex == 0) { currentState = MenuState.EXERCISE_MENU; currentIndex = 0; }\n            else if (currentIndex == 1) { currentState = MenuState.CONFIG_MENU; currentIndex = 0; }\n            else if (currentIndex == 3) { currentState = MenuState.POWER_OFF; }\n            break\n\n        case MenuState.EXERCISE_MENU:\n            if (currentIndex == 4) { // Back[cite: 3]\n                currentState = MenuState.MAIN_MENU\n                currentIndex = 0\n            }\n            break\n\n        case MenuState.CONFIG_MENU:\n            if (currentIndex == 0) currentState = MenuState.CONFIG_REP\n            else if (currentIndex == 1) currentState = MenuState.CONFIG_ACC\n            else if (currentIndex == 2) currentState = MenuState.CONFIG_DATETIME\n            else if (currentIndex == 3) currentState = MenuState.CONFIG_BLE\n            else if (currentIndex == 4) currentState = MenuState.CONFIG_CLEAR\n            else if (currentIndex == 5) { // Back[cite: 3]\n                currentState = MenuState.MAIN_MENU\n                currentIndex = 0\n            }\n            break\n\n        default:\n            currentState = MenuState.CONFIG_MENU\n            break\n    }\n    renderUI()\n})\n\n// ==========================================\n// 5. INITIALIZATION\n// ==========================================\nRBTFT18.init()\nrenderUI(true)"]]}]}]},{"timestamp":1786090198461,"editorVersion":"9.0.8","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":128,"diffs":[[1,""]]},{"start1":1,"length1":2510,"diffs":[[1,""]]}]}]},{"timestamp":1786091229451,"editorVersion":"9.0.8","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":0,"diffs":[[1,"// ==========================================\n// 1. HELPER RENDERER FOR FONT 8x16\n// ==========================================\n\n// ฟังก์ชันสำหรับวาดตัวอักษร 1 ตัวอักษรขนาด 8x16 พิกเซล\nfunction drawChar8x16(char: string, x: number, y: number, fgColor: Color, bgColor: Color) {\n    let code = char.charCodeAt(0)\n    let fontData: number[] = null\n\n    // ตรวจสอบโครงสร้างตัวแปร Font8x16 ในโปรเจกต์ข้ามไฟล์\n    if (typeof Font8x16 !== \"undefined\") {\n        if (typeof (Font8x16 as any).getCharBytes === \"function\") {\n            fontData = (Font8x16 as any).getCharBytes(code)\n        } else if (Array.isArray(Font8x16 as any)) {\n            fontData = (Font8x16 as any)[code] || (Font8x16 as any)[code - 32]\n        } else if ((Font8x16 as any)[code]) {\n            fontData = (Font8x16 as any)[code]\n        }\n    }\n\n    // หากดึงค่า Bitmap พิกเซลจาก Font8x16 ได้สำเร็จ จะทำการ Render ทีละพิกเซล\n    if (fontData && fontData.length >= 16) {\n        for (let row = 0; row < 16; row++) {\n            let byte = fontData[row]\n            for (let col = 0; col < 8; col++) {\n                if ((byte & (0x80 >> col)) != 0) {\n                    RBTFT18.drawPixel(x + col, y + row, fgColor)[cite: 4]\n                } else {\n                    RBTFT18.drawPixel(x + col, y + row, bgColor)[cite: 4]\n                }\n            }\n        }\n    } else {\n        // Fallback: หากไม่พบโครงสร้าง Array ใน font8x16.ts ให้ใช้โหมด Zoom Level 2 (8x16) ของไดรเวอร์แทน\n        RBTFT18.showString(char, x, y, 2, fgColor, bgColor)[cite: 4]\n    }\n}\n\n// ฟังก์ชันสำหรับวาดข้อความด้วย Font 8x16 พร้อมระบบขึ้นบรรทัดใหม่อัตโนมัติ\nfunction drawString8x16(text: string, startX: number, startY: number, fgColor: Color, bgColor: Color) {\n    let currentX = startX\n    let currentY = startY\n    const screenWidth = 128\n    const charWidth = 8\n    const charHeight = 16\n\n    for (let i = 0; i < text.length; i++) {\n        // เช็คว่าตำแหน่ง X เกินขนาดความกว้างจอหรือไม่ หากเกินให้ขยับลงบรรทัดใหม่\n        if (currentX + charWidth > screenWidth) {\n            currentX = startX\n            currentY += charHeight + 2 // เว้นระยะบรรทัด 2 พิกเซล\n        }\n\n        drawChar8x16(text.charAt(i), currentX, currentY, fgColor, bgColor)\n        currentX += charWidth\n    }\n}\n\n// ==========================================\n// 2. MAIN PROGRAM\n// ==========================================\n\n// เริ่มต้นเปิดการทำงานจอภาพ RBTFT18\nRBTFT18.init()[cite: 4]\nRBTFT18.clearScreen()[cite: 4]\n\n// วาดข้อความ \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\" ด้วย Font 8x16 สีเขียว บนพื้นหลังสีดำ\nlet textToDisplay = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\ndrawString8x16(textToDisplay, 0, 10, Color.Green, Color.Black)\n"]]}]}]},{"timestamp":1786091916503,"editorVersion":"9.0.8","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":159,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"></block></xml>"]]}]}]},{"timestamp":1786092043220,"editorVersion":"9.0.8","changes":[{"type":"edited","filename":"pxt.json","patch":[{"start1":437,"length1":44,"diffs":[[1,""]]}]},{"type":"added","filename":"test.ts","value":"// tests go here; this will not be compiled when this package is used as an extension.\n"}]}],"snapshots":[{"timestamp":1785998160099,"editorVersion":"9.0.8","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>","main.ts":"\n","README.md":"","pxt.json":"{\n    \"name\": \"Font Lab 8x16\",\n    \"